{
  "expo": {
    "name": "SIA-Offline",
    "slug": "sia-offline",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.yourname.siaoffline",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "Allow SIA to access your microphone for voice commands."
        }
      ]
    ]
  }
}